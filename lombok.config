# Stop at this directory; do not inherit config from parent folders.
config.stopBubbling = true

# Jackson 3 (tools.jackson) arrives transitively, so @Jacksonized cannot tell which variant
# to generate for and defaults to 2 with a warning on every pojo. This suite is on Jackson 2
# (com.fasterxml.jackson), so state it and keep the build warning-free.
lombok.jacksonized.jacksonVersion = 2
